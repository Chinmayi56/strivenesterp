# StriveNest ERP System - Environment Configuration Example

# Application Settings
APP_NAME="StriveNest ERP Backend"
APP_VERSION="1.0.0"
APP_DESCRIPTION="Enterprise Resource Planning Backend Foundation"
API_PREFIX="/api/v1"
DEBUG=True
LOG_LEVEL="INFO"
ENVIRONMENT="development"  # development, testing, production

# Server Settings
HOST="0.0.0.0"
PORT=8000
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["*"]

# Database Settings
# For PostgreSQL: postgresql://strivenest_user:strivenest_pass@localhost:5432/strivenest_db
# For Async PostgreSQL: postgresql+asyncpg://strivenest_user:strivenest_pass@localhost:5432/strivenest_db
# For SQLite (Local/Fallback): sqlite:///./strivenest.db
DATABASE_URL="sqlite:///./strivenest.db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# Logging
LOG_TO_FILE=True
LOG_FILE_PATH="logs/app.log"

# JWT Authentication & Security Settings
JWT_SECRET_KEY="strivenest_super_secret_jwt_key_phase2a_2026_enterprise_erp"
JWT_REFRESH_SECRET_KEY="strivenest_super_secret_refresh_jwt_key_phase2a_2026_enterprise_erp"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
